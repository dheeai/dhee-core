# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.dhee/
# Testing
coverage/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
*.tsbuildinfo

# Subprojects
prompt-optimizer/

# Project data — dhee/dhee project folders live at repo root during
