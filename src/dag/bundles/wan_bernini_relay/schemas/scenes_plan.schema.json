{
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene_[0-9]+$" },
          "title": { "type": "string" },
          "action": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
