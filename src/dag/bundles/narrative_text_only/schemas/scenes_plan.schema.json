{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["totalDurationSec", "style", "scenes"],
  "properties": {
    "totalDurationSec": { "type": "number" },
    "style": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneNumber", "settingDescription", "shots"],
        "properties": {
          "sceneNumber": { "type": "number" },
          "settingDescription": { "type": "string" },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["shotNumber", "durationSec", "description", "dialogue"],
              "properties": {
                "shotNumber": { "type": "number" },
                "durationSec": { "type": "number" },
                "description": { "type": "string" },
                "dialogue": {
                  "type": "object",
                  "required": ["speaker", "line"],
                  "properties": {
                    "speaker": { "type": "string" },
                    "line": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
