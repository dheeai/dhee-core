{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["totalDurationSec", "shots"],
  "properties": {
    "totalDurationSec": { "type": "number" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shotNumber", "durationSec", "imagePrompt", "motionDirective", "dialogueLine"],
        "properties": {
          "shotNumber": { "type": "number" },
          "durationSec": { "type": "number" },
          "imagePrompt": { "type": "string" },
          "motionDirective": { "type": "string" },
          "dialogueLine": { "type": "string" }
        }
      }
    }
  }
}
