{
  "id": "ltx_prompt_relay",
  "version": "0.1.0",
  "engineCompat": ">=0.1.0",
  "description": "LTX 2.3 prompt relay — renders each scene as one or more chunk clips via the LTX Director workflow, then concats them into a single final video. The bundle handles auto-chunking under the 1000-frame LTX cap.",
  "dependencies": {
    "runners": {
      "comfy.ltx_director": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0"
    }
  },
  "goal": "final_video",
  "nodes": [
    {
      "id": "scene_clip",
      "kind": "collection",
      "itemSource": "scene",
      "chunkBy": {
        "constraint": "max_frames",
        "limit": 1000,
        "fps": 24,
        "firstSegmentPlusOne": true,
        "maxFramePixels": 409920000,
        "referenceVramBytes": 12884901888
      },
      "inputs": [],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/dag_relay/{{scene_id}}.mp4"
      },
      "runner": {
        "tool": "comfy.ltx_director",
        "config": {
          "workflowPath": "workflows/built-in/ltx23_director_local.json",
          "endpoint": "self.local",
          "fps": 24,
          "width": 854,
          "height": 480
        }
      }
    },
    {
      "id": "final_video",
      "kind": "stage",
      "inputs": [
        {
          "from": "scene_clip",
          "usage": "input",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/final/dag_relay_final.mp4"
      },
      "runner": {
        "tool": "ffmpeg.concat",
        "config": {}
      }
    }
  ]
}
