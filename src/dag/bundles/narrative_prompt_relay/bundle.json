{
  "id": "narrative_prompt_relay",
  "version": "0.1.0",
  "engineCompat": ">=0.1.0",
  "description": "Full narrative pipeline from plot to final video, with LTX Director relay synthesis for the video stage on a local Comfy endpoint.",
  "dependencies": {
    "runners": {
      "llm.generate": ">=0.1.0",
      "comfy.image": ">=0.1.0",
      "comfy.ltx_director": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0"
    }
  },
  "inputs": [
    { "id": "story_input", "kind": "file", "path": "inputs/story.md", "required": true },
    { "id": "targetDuration", "kind": "project", "field": "targetDuration", "default": 25 },
    { "id": "style", "kind": "project", "field": "style", "default": "cinematic_realism" }
  ],
  "goal": "final_video",
  "nodes": [
    {
      "id": "plot",
      "kind": "stage",
      "inputs": [],
      "outputs": { "format": "md", "pattern": "plans/plot.md" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/plot.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      }
    },
    {
      "id": "story",
      "kind": "stage",
      "inputs": [{ "from": "plot", "usage": "context" }],
      "outputs": { "format": "md", "pattern": "plans/story.md" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      }
    },
    {
      "id": "story_essence",
      "kind": "stage",
      "inputs": [{ "from": "story", "usage": "context" }],
      "outputs": { "format": "json", "pattern": "plans/story_essence.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story_essence.md",
          "outputSchema": "schemas/story_essence.schema.json",
          "tier": "medium",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "world_style",
      "kind": "stage",
      "inputs": [
        { "from": "story", "usage": "context" },
        { "from": "story_essence", "usage": "context" }
      ],
      "outputs": { "format": "md", "pattern": "plans/world_style.md" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/world_style.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      }
    },
    {
      "id": "characters_plan",
      "kind": "stage",
      "inputs": [
        { "from": "story", "usage": "context" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "plans/characters_plan.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/characters_plan.md",
          "outputSchema": "schemas/characters_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "character_image_prompt",
      "kind": "collection",
      "itemSource": "characters_plan",
      "inputs": [
        { "from": "characters_plan", "usage": "input", "scope": "matching" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "prompts/character_images/{{item_id}}.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/character_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "settings_plan",
      "kind": "stage",
      "inputs": [
        { "from": "story", "usage": "context" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "plans/settings_plan.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/settings_plan.md",
          "outputSchema": "schemas/settings_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "setting_image_prompt",
      "kind": "collection",
      "itemSource": "settings_plan",
      "inputs": [
        { "from": "settings_plan", "usage": "input", "scope": "matching" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "prompts/setting_images/{{item_id}}.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/setting_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "scenes_plan",
      "kind": "stage",
      "inputs": [
        { "from": "story", "usage": "context" },
        { "from": "story_essence", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "plans/scenes_plan.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/scenes_plan.md",
          "outputSchema": "schemas/scenes_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json",
          "maxTokens": 8000
        }
      }
    },
    {
      "id": "shot_image_prompt",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        { "from": "scenes_plan", "usage": "input", "scope": "matching" },
        { "from": "world_style", "usage": "context" },
        { "from": "characters_plan", "usage": "context" },
        { "from": "settings_plan", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "prompts/shot_image/{{item_id}}.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_image_prompt.md",
          "outputSchema": "schemas/shot_image_prompt.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "shot_motion_directive",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        { "from": "scenes_plan", "usage": "input", "scope": "matching" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "json", "pattern": "prompts/motion/{{item_id}}.json" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_motion_directive.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      }
    },
    {
      "id": "scene_video_prompt",
      "kind": "stage",
      "inputs": [
        { "from": "scenes_plan", "usage": "input" },
        { "from": "story_essence", "usage": "context" },
        { "from": "world_style", "usage": "context" }
      ],
      "outputs": { "format": "md", "pattern": "prompts/scene_video_prompt.md" },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/scene_video_prompt.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      }
    },
    {
      "id": "scene_clip",
      "kind": "collection",
      "itemSource": "scene",
      "chunkBy": {
        "constraint": "max_frames",
        "limit": 1000,
        "fps": 24,
        "firstSegmentPlusOne": true
      },
      "inputs": [
        { "from": "shot_image_prompt", "usage": "input", "scope": "all" },
        { "from": "shot_motion_directive", "usage": "input", "scope": "all" },
        { "from": "scene_video_prompt", "usage": "context" }
      ],
      "outputs": { "format": "video", "pattern": "assets/videos/dag_relay/{{scene_id}}_{{chunk_id}}.mp4" },
      "runner": {
        "tool": "comfy.ltx_director",
        "config": {
          "workflowPath": "workflows/ltx_director_local.json",
          "endpoint": "self.local",
          "fps": 24,
          "width": 854,
          "height": 480
        }
      }
    },
    {
      "id": "final_video",
      "kind": "stage",
      "inputs": [{ "from": "scene_clip", "usage": "input", "scope": "all" }],
      "outputs": { "format": "video", "pattern": "assets/videos/final/final_video.mp4" },
      "runner": { "tool": "ffmpeg.concat", "config": {} }
    }
  ]
}
