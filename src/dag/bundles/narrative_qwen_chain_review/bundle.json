{
  "id": "narrative_qwen_chain_review",
  "version": "0.1.0",
  "engineCompat": ">=0.1.0",
  "description": "Quality-gated variant of narrative_qwen_chain_relay. Each shot image is judged by a VLM (xiaomi/mimo-v2.5 by default); on fail, the walker re-runs shot_image_prompt with the judge's critique applied and re-renders. Up to 3 total attempts per shot — the runner keeps the BEST of N (passing attempt earliest, else highest-scoring) at the canonical path so downstream LTX consumes the strongest available image.",
  "reviewLoopMax": 3,
  "dependencies": {
    "runners": {
      "llm.generate": ">=0.1.0",
      "comfy.image": ">=0.1.0",
      "comfy.qwen_edit_chain": ">=0.1.0",
      "comfy.ltx_director": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0",
      "vlm.judge": ">=0.1.0"
    }
  },
  "inputs": [
    {
      "id": "story_input",
      "kind": "file",
      "path": "inputs/story.md",
      "required": true
    },
    {
      "id": "style_guide",
      "kind": "file",
      "path": "plans/world_style.md",
      "label": "Art direction (optional)",
      "placeholder": "Paste a full visual style guide — palette, light, linework, character locks, what to avoid. It becomes the project's style bible verbatim (no LLM rewrite). Leave blank to auto-generate from your story + style preset.",
      "multiline": true,
      "required": false
    },
    {
      "id": "targetDuration",
      "kind": "project",
      "field": "targetDuration",
      "default": 25
    },
    {
      "id": "style",
      "kind": "project",
      "field": "style",
      "default": "cinematic_realism"
    }
  ],
  "goal": "final_video",
  "nodes": [
    {
      "id": "plot",
      "kind": "stage",
      "inputs": [],
      "outputs": {
        "format": "md",
        "pattern": "plans/plot.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/plot.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "plot.outline"
    },
    {
      "id": "story",
      "kind": "stage",
      "inputs": [
        {
          "from": "plot",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "plans/story.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "story.prose"
    },
    {
      "id": "story_essence",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/story_essence.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story_essence.md",
          "outputSchema": "schemas/story_essence.schema.json",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "displayCapability": "story.essence"
    },
    {
      "id": "world_style",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "story_essence",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "plans/world_style.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/world_style.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "style.world"
    },
    {
      "id": "characters_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/characters_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/characters_plan.md",
          "outputSchema": "schemas/characters_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "character.plan"
    },
    {
      "id": "character_image_prompt",
      "kind": "collection",
      "itemSource": "characters_plan",
      "inputs": [
        {
          "from": "characters_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/character_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/character_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "characters",
      "displayCapability": "character.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "character_image",
      "kind": "collection",
      "itemSource": "character_image_prompt",
      "inputs": [
        {
          "from": "character_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/characters/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/zimage_tti.json",
          "manifestPath": "workflows/zimage_tti.manifest.json",
          "endpoint": "public.cloud",
          "width": 1024,
          "height": 1024
        }
      },
      "displayCapability": "character.image"
    },
    {
      "id": "settings_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/settings_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/settings_plan.md",
          "outputSchema": "schemas/settings_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "setting.plan"
    },
    {
      "id": "setting_image_prompt",
      "kind": "collection",
      "itemSource": "settings_plan",
      "inputs": [
        {
          "from": "settings_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/setting_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/setting_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "settings",
      "displayCapability": "setting.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "setting_image",
      "kind": "collection",
      "itemSource": "setting_image_prompt",
      "inputs": [
        {
          "from": "setting_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/settings/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/zimage_tti.json",
          "manifestPath": "workflows/zimage_tti.manifest.json",
          "endpoint": "public.cloud",
          "width": 1920,
          "height": 1080
        }
      },
      "displayCapability": "setting.image"
    },
    {
      "id": "scenes_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "story_essence",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/scenes_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/scenes_plan.md",
          "outputSchema": "schemas/scenes_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json",
          "maxTokens": 16000
        }
      },
      "displayCapability": "scene.plan"
    },
    {
      "id": "shot_image_prompt",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        {
          "from": "scenes_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_image_prompt",
          "usage": "context",
          "scope": "previousN",
          "n": 5
        },
        {
          "from": "world_style",
          "usage": "context"
        },
        {
          "from": "characters_plan",
          "usage": "context"
        },
        {
          "from": "settings_plan",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/shot_image/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_image_prompt.md",
          "outputSchema": "schemas/shot_image_prompt.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "itemKey": "shots",
      "displayCapability": "shot.prompt",
      "headlineField": "deltaText"
    },
    {
      "id": "shot_image",
      "kind": "collection",
      "itemSource": "shot_image_prompt",
      "inputs": [
        {
          "from": "shot_image_prompt",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_image",
          "usage": "input",
          "scope": "previousN",
          "n": 5
        },
        {
          "from": "character_image",
          "usage": "reference",
          "scope": "all"
        },
        {
          "from": "setting_image",
          "usage": "reference",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/shots/{{item_id}}_first.png"
      },
      "runner": {
        "tool": "comfy.qwen_edit_chain",
        "config": {
          "workflowPath": "workflows/qwen_edit_multi.json",
          "endpoint": "public.cloud",
          "multiAngleStrength": 0.9,
          "width": 1024,
          "height": 1024
        }
      },
      "displayCapability": "shot.first_frame"
    },
    {
      "id": "shot_image_review",
      "kind": "collection",
      "itemSource": "shot_image",
      "inputs": [
        {
          "from": "shot_image",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_image_prompt",
          "usage": "context",
          "scope": "matching"
        },
        {
          "from": "characters_plan",
          "usage": "context"
        },
        {
          "from": "settings_plan",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "reviews/shot_image/{{item_id}}.json"
      },
      "runner": {
        "tool": "vlm.judge",
        "config": {
          "imageInput": "shot_image",
          "refineNode": "shot_image_prompt",
          "passThreshold": 0.7,
          "criteria": "Judge on: (1) Character identity — every named character looks like their canonical description in characters_plan; (2) Action subject/object — the right character does the right thing to the right target (gun direction, who-kisses-who, etc.); (3) Setting fidelity — background matches the named location in settings_plan; (4) No gray-studio backdrop bleed; (5) No significant anatomical / compositional artifacts (extra limbs, doubled faces, melted features)."
        }
      },
      "displayCapability": "shot.review",
      "headlineField": "notes"
    },
    {
      "id": "shot_motion_directive",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        {
          "from": "scenes_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/motion/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_motion_directive.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "shots",
      "displayCapability": "shot.motion",
      "headlineField": "description"
    },
    {
      "id": "scene_video_prompt",
      "kind": "stage",
      "inputs": [
        {
          "from": "scenes_plan",
          "usage": "input"
        },
        {
          "from": "story_essence",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "prompts/scene_video_prompt.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/scene_video_prompt.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "scene.video_prompt"
    },
    {
      "id": "scene_clip",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "chunkBy": {
        "constraint": "max_frames",
        "limit": 1000,
        "fps": 24,
        "firstSegmentPlusOne": true
      },
      "inputs": [
        {
          "from": "shot_image",
          "usage": "input",
          "scope": "all"
        },
        {
          "from": "shot_motion_directive",
          "usage": "input",
          "scope": "all"
        },
        {
          "from": "scene_video_prompt",
          "usage": "context"
        },
        {
          "from": "shot_image_review",
          "usage": "context",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/dag_relay/{{scene_id}}_{{chunk_id}}.mp4"
      },
      "runner": {
        "tool": "comfy.ltx_director",
        "config": {
          "workflowPath": "workflows/ltx_director_local.json",
          "endpoint": "self.local",
          "fps": 24,
          "width": 854,
          "height": 480
        }
      },
      "itemKey": "scenes",
      "displayCapability": "scene.video"
    },
    {
      "id": "final_video",
      "kind": "stage",
      "inputs": [
        {
          "from": "scene_clip",
          "usage": "input",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/final/final_video.mp4"
      },
      "runner": {
        "tool": "ffmpeg.concat",
        "config": {}
      },
      "displayCapability": "final.video"
    }
  ],
  "display": {
    "thumbnail": {
      "from": "shot.first_frame",
      "pick": "first_completed"
    },
    "stats": [
      {
        "label": "scenes",
        "source": "scene.plan",
        "path": "scenes.length"
      },
      {
        "label": "shots",
        "source": "scene.plan",
        "path": "shots.length"
      }
    ]
  }
}
