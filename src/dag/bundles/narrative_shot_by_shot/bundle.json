{
  "id": "narrative_shot_by_shot",
  "version": "0.1.0",
  "displayName": "Narrative Shot by Shot",
  "summary": "Precise per-shot control. Best for dialogue + composed scenes.",
  "engineCompat": ">=0.1.0",
  "description": "Full narrative pipeline with per-shot FL2V video synthesis on cloud Comfy.",
  "dependencies": {
    "runners": {
      "llm.generate": ">=0.1.0",
      "comfy.image": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0"
    }
  },
  "inputs": [
    {
      "id": "story_input",
      "kind": "file",
      "path": "inputs/story.md",
      "required": true
    },
    {
      "id": "targetDuration",
      "kind": "project",
      "field": "targetDuration",
      "default": 25
    },
    {
      "id": "style",
      "kind": "project",
      "field": "style",
      "default": "cinematic_realism"
    }
  ],
  "goal": "final_video",
  "nodes": [
    {
      "id": "plot",
      "kind": "stage",
      "inputs": [],
      "outputs": {
        "format": "md",
        "pattern": "plans/plot.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/plot.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "plot.outline"
    },
    {
      "id": "story",
      "kind": "stage",
      "inputs": [
        {
          "from": "plot",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "plans/story.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "story.prose"
    },
    {
      "id": "story_essence",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/story_essence.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/story_essence.md",
          "outputSchema": "schemas/story_essence.schema.json",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "displayCapability": "story.essence"
    },
    {
      "id": "world_style",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "story_essence",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "plans/world_style.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/world_style.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "style.world"
    },
    {
      "id": "characters_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/characters_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/characters_plan.md",
          "outputSchema": "schemas/characters_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "character.plan"
    },
    {
      "id": "character_image_prompt",
      "kind": "collection",
      "itemSource": "characters_plan",
      "inputs": [
        {
          "from": "characters_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/character_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/character_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "characters",
      "displayCapability": "character.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "character_image",
      "kind": "collection",
      "itemSource": "character_image_prompt",
      "inputs": [
        {
          "from": "character_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/characters/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/zimage_tti.json",
          "manifestPath": "workflows/zimage_tti.manifest.json",
          "endpoint": "public.cloud",
          "width": 1024,
          "height": 1024
        }
      },
      "displayCapability": "character.image"
    },
    {
      "id": "settings_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/settings_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/settings_plan.md",
          "outputSchema": "schemas/settings_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "setting.plan"
    },
    {
      "id": "setting_image_prompt",
      "kind": "collection",
      "itemSource": "settings_plan",
      "inputs": [
        {
          "from": "settings_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/setting_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/setting_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "settings",
      "displayCapability": "setting.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "setting_image",
      "kind": "collection",
      "itemSource": "setting_image_prompt",
      "inputs": [
        {
          "from": "setting_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/settings/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/zimage_tti.json",
          "manifestPath": "workflows/zimage_tti.manifest.json",
          "endpoint": "public.cloud",
          "width": 1920,
          "height": 1080
        }
      },
      "displayCapability": "setting.image"
    },
    {
      "id": "scenes_plan",
      "kind": "stage",
      "inputs": [
        {
          "from": "story",
          "usage": "context"
        },
        {
          "from": "story_essence",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/scenes_plan.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/scenes_plan.md",
          "outputSchema": "schemas/scenes_plan.schema.json",
          "tier": "heavy",
          "outputFormat": "json",
          "maxTokens": 8000
        }
      },
      "displayCapability": "scene.plan"
    },
    {
      "id": "shot_image_prompt",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        {
          "from": "scenes_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        },
        {
          "from": "characters_plan",
          "usage": "context"
        },
        {
          "from": "settings_plan",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/shot_image/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_image_prompt.md",
          "outputSchema": "schemas/shot_image_prompt.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "itemKey": "shots",
      "displayCapability": "shot.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "shot_image",
      "kind": "collection",
      "itemSource": "shot_image_prompt",
      "inputs": [
        {
          "from": "shot_image_prompt",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "character_image",
          "usage": "reference",
          "scope": "all"
        },
        {
          "from": "setting_image",
          "usage": "reference",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/shots/{{item_id}}_first.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/klein.json",
          "manifestPath": "workflows/klein.manifest.json",
          "endpoint": "public.cloud",
          "width": 1920,
          "height": 1080
        }
      },
      "displayCapability": "shot.first_frame"
    },
    {
      "id": "shot_image_last_frame_prompt",
      "kind": "collection",
      "itemSource": "shot_image_prompt",
      "inputs": [
        {
          "from": "shot_image_prompt",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "scenes_plan",
          "usage": "context"
        },
        {
          "from": "world_style",
          "usage": "context"
        },
        {
          "from": "characters_plan",
          "usage": "context"
        },
        {
          "from": "settings_plan",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/shot_image_last_frame/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_image_last_frame.md",
          "outputSchema": "schemas/shot_image_prompt.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "shot.last_prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "shot_image_last_frame",
      "kind": "collection",
      "itemSource": "shot_image_last_frame_prompt",
      "inputs": [
        {
          "from": "shot_image_last_frame_prompt",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_image",
          "usage": "reference",
          "scope": "all"
        },
        {
          "from": "character_image",
          "usage": "reference",
          "scope": "all"
        },
        {
          "from": "setting_image",
          "usage": "reference",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/shots/{{item_id}}_last.png"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/klein.json",
          "manifestPath": "workflows/klein.manifest.json",
          "endpoint": "public.cloud",
          "width": 1920,
          "height": 1080
        }
      },
      "displayCapability": "shot.last_frame"
    },
    {
      "id": "shot_motion_directive",
      "kind": "collection",
      "itemSource": "scenes_plan",
      "inputs": [
        {
          "from": "scenes_plan",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/motion/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_motion_directive.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "itemKey": "shots",
      "displayCapability": "shot.motion",
      "headlineField": "description"
    },
    {
      "id": "shot_video",
      "kind": "collection",
      "itemSource": "shot_image",
      "inputs": [
        {
          "from": "shot_image",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_image_last_frame",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_motion_directive",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/shots/{{item_id}}.mp4"
      },
      "runner": {
        "tool": "comfy.image",
        "config": {
          "workflowPath": "workflows/fl2v_cloud.json",
          "manifestPath": "workflows/fl2v_cloud.manifest.json",
          "endpoint": "public.cloud",
          "width": 1216,
          "height": 704
        }
      },
      "displayCapability": "shot.video"
    },
    {
      "id": "final_video",
      "kind": "stage",
      "inputs": [
        {
          "from": "shot_video",
          "usage": "input",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/final/final_video.mp4"
      },
      "runner": {
        "tool": "ffmpeg.concat",
        "config": {}
      },
      "displayCapability": "final.video"
    }
  ],
  "display": {
    "thumbnail": {
      "from": "shot.first_frame",
      "pick": "first_completed"
    },
    "stats": [
      {
        "label": "scenes",
        "source": "scene.plan",
        "path": "scenes.length"
      },
      {
        "label": "shots",
        "source": "scene.plan",
        "path": "shots.length"
      }
    ]
  }
}
