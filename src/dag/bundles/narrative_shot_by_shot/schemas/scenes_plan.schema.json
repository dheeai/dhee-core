{
  "type": "object",
  "required": ["scenes", "shots"],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "mainSubject", "narrativeMode"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene_[0-9]+$" },
          "title": { "type": "string" },
          "mainSubject": { "type": "string" },
          "narrativeMode": { "type": "string", "enum": ["setup", "rising", "climax", "resolution"] },
          "settingId": { "type": "string" }
        }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scene", "shotNumber", "duration", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene_[0-9]+_shot_[0-9]+$" },
          "scene": { "type": "integer" },
          "shotNumber": { "type": "integer" },
          "duration": { "type": "integer", "minimum": 1, "maximum": 15 },
          "description": { "type": "string" },
          "cameraWork": { "type": "string" },
          "mainSubject": { "type": "string" }
        }
      }
    }
  }
}
