{
  "name": "dhee-core",
  "version": "0.1.0",
  "description": "AI video generation engine — story → screenplay → shots → keyframes → clips → final assembly.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.cjs",
    "./server/cli": "./dist/server/cli.cjs",
    "./core/llm": {
      "types": "./dist/core/llm/index.d.ts",
      "default": "./dist/core/llm/index.js"
    },
    "./runners": {
      "types": "./dist/server/runners/index.d.ts",
      "default": "./dist/server/runners/index.js"
    },
    "./agent/pi": {
      "types": "./dist/agent/pi/index.d.ts",
      "default": "./dist/agent/pi/index.js"
    },
    "./dag": {
      "types": "./dist/dag/index.d.ts",
      "default": "./dist/dag/index.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "workflows",
    "README.md"
  ],
  "bin": {
    "dhee-core": "./dist/index.js",
    "dhee-core-server": "./dist/server/cli.cjs"
  },
  "scripts": {
    "cli": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/index.ts",
    "kill": "pkill -f 'tsx.*src/index.ts' || true; echo 'All dhee processes killed'",
    "build": "pnpm -C packages/runner-sdk run build && pnpm -C packages/openrouter-image-runner run build && pnpm -C frontend run build && tsup",
    "build:frontend": "pnpm -C frontend run build",
    "test:frontend": "pnpm -C frontend test",
    "test": "vitest run tests/unit/",
    "test:ci": "vitest run tests/unit/",
    "lint:prompts": "bash scripts/lint-prompts-no-slot-tokens.sh",
    "test:e2e": "vitest run tests/e2e/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "remotion:studio": "cd remotion-infographics && remotion studio src/index.tsx",
    "analytics:backfill:posthog": "tsx scripts/backfill-posthog-from-sqlite.ts",
    "analytics:dashboard:posthog": "tsx scripts/create-posthog-desktop-project-dashboard.ts",
    "drive": "tsx src/agent/pi/drive.ts"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "terminal"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dhee/runner-sdk": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@mariozechner/pi-agent-core": "^0.70.6",
    "@mariozechner/pi-ai": "^0.70.6",
    "@mariozechner/pi-coding-agent": "^0.70.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.1",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.5",
    "openai": "^4.72.0",
    "posthog-node": "^5.28.1",
    "react": "^18.3.1",
    "semver": "^7.8.1",
    "sharp": "^0.34.5",
    "typebox": "^1.1.34",
    "uuid": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/semver": "^7.7.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.3",
    "ws": "^8.18.0"
  }
}
