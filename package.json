{
  "name": "dhee-core",
  "version": "0.1.0",
  "description": "AI video generation engine \u2014 story \u2192 screenplay \u2192 shots \u2192 keyframes \u2192 clips \u2192 final assembly.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.cjs",
    "./server/cli": "./dist/server/cli.cjs",
    "./core/llm": {
      "types": "./dist/core/llm/index.d.ts",
      "default": "./dist/core/llm/index.js"
    },
    "./runners": {
      "types": "./dist/server/runners/index.d.ts",
      "default": "./dist/server/runners/index.js"
    },
    "./agent/pi": {
      "types": "./dist/agent/pi/index.d.ts",
      "default": "./dist/agent/pi/index.js"
    },
    "./dag": {
      "types": "./dist/dag/index.d.ts",
      "default": "./dist/dag/index.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "workflows",
    "assets",
    "README.md"
  ],
  "bin": {
    "dhee-core": "./dist/index.js",
    "dhee-core-server": "./dist/server/cli.cjs"
  },
  "scripts": {
    "cli": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/index.ts",
    "kill": "pkill -f 'tsx.*src/index.ts' || true; echo 'All dhee processes killed'",
    "build": "pnpm -C frontend run build && tsup",
    "build:frontend": "pnpm -C frontend run build",
    "test:frontend": "pnpm -C frontend test",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "lint:prompts": "bash scripts/lint-prompts-no-slot-tokens.sh",
    "test:e2e": "vitest run tests/e2e/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "analytics:backfill:posthog": "tsx scripts/backfill-posthog-from-sqlite.ts",
    "analytics:dashboard:posthog": "tsx scripts/create-posthog-desktop-project-dashboard.ts",
    "drive": "tsx src/agent/pi/drive.ts",
    "dhee": "NODE_OPTIONS='--max-old-space-size=8192' tsx scripts/dhee-cli.ts",
    "llm-usage": "tsx scripts/llm-usage-report.ts",
    "gen-bundle-requirements": "tsx scripts/gen-bundle-requirements.ts"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "terminal"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "fastify@<=5.7.2": ">=5.7.3",
      "fastify@<5.7.2": ">=5.7.2",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@<3.1.4": ">=3.1.4",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "fastify@<=5.8.2": ">=5.8.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
      "postcss@<8.5.10": ">=8.5.10",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "fast-xml-builder@=1.1.5": ">=1.1.6",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "protobufjs@<=7.5.7": ">=7.5.8",
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": ">=0.91.1",
      "uuid@>=13.0.0 <13.0.1": ">=13.0.1 <14",
      "vitest@<3.2.6": ">=3.2.6 <4",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "protobufjs@<=7.6.0": ">=7.6.1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mariozechner/pi-agent-core": "^0.70.6",
    "@mariozechner/pi-ai": "^0.70.6",
    "@mariozechner/pi-coding-agent": "^0.70.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.1",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.5",
    "openai": "^4.72.0",
    "posthog-node": "^5.28.1",
    "react": "^18.3.1",
    "semver": "^7.8.1",
    "typebox": "^1.1.34",
    "uuid": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@dheeai/runner-sdk": "^0.5.0",
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/semver": "^7.7.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.3",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.3",
    "ws": "^8.18.0"
  }
}
