{
  "id": "satire_lineup",
  "version": "0.1.0",
  "license": "MIT",
  "displayName": "Satire Lineup (edit-first talking-head reel)",
  "summary": "Inject ONE script that defines a cast of characters (each with a visual design, its own setting, an exact spoken line, an emotion and SFX). The bundle derives the cast FROM the script (number of actors is not pre-decided), generates a clean locked actor + an empty setting per character, EDIT-COMPOSITES the exact actor into the scene as a pixel-locked first frame (boogu reference-edit), designs a voice per character and voices the EXACT line (OmniVoice, native script), then animates each locked frame as a lip-synced talking head (LTX Director). Clips are concatenated into the final reel. Built for character-monologue satire / lineup reels.",
  "techLine": "SCRIPT-DRIVEN CAST · EDIT-FIRST FRAME · TALKING-HEAD LIP-SYNC",
  "engineCompat": ">=0.1.0",
  "description": "A lineup reel pipeline. Unlike a connected narrative, every character is an independent vignette: one actor, in its own setting, speaking one exact line to camera. The cast (and how many actors) is extracted from the injected script, so N is data-driven. Each character: (1) a clean locked actor image (comfy.tti) — the reusable on-model asset; (2) an empty setting plate (comfy.tti); (3) an EDIT-FIRST composite (comfy.boogu reference-edit) that places the exact actor into the exact scene with the right pose/expression — a pixel-locked first frame, so identity does not drift the way multi-subject-reference video does; (4) a designed voice (OmniVoice voice design) speaking the EXACT scripted line verbatim (OmniVoice clone, native script); (5) LTX Director talking-head lip-sync animating only that locked frame. Concatenated to the final cut.",
  "dependencies": {
    "runners": {
      "llm.generate": ">=0.1.0",
      "comfy.tti": ">=0.1.0",
      "comfy.tts": ">=0.1.0",
      "comfy.ltx_director": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0"
    },
    "runnerPackages": {
      "comfy.tts": "@dhee_ai/runner-tts"
    }
  },
  "inputs": [
    {
      "id": "script_input",
      "kind": "file",
      "path": "inputs/script.md",
      "required": false,
      "label": "Your script",
      "placeholder": "Define each character: a visual design, its own setting, the EXACT line it speaks (in the spoken language / native script), an emotion, and SFX. One block per character. The number of characters here = the number of actors in the reel.",
      "multiline": true
    },
    {
      "id": "language",
      "kind": "project",
      "field": "language",
      "default": "Hindi",
      "label": "Spoken language",
      "control": "text"
    },
    {
      "id": "style",
      "kind": "project",
      "field": "style",
      "default": "cinematic_realism",
      "label": "Style",
      "control": "select",
      "options": [
        {
          "value": "cinematic_realism",
          "label": "Cinematic Realism"
        },
        {
          "value": "animation",
          "label": "Animation"
        },
        {
          "value": "noir",
          "label": "Film Noir"
        }
      ],
      "allowCustom": true
    },
    {
      "id": "aspect",
      "kind": "project",
      "field": "aspect",
      "default": "9:16",
      "label": "Aspect",
      "control": "pills",
      "options": [
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "9:16",
          "label": "9:16"
        }
      ]
    }
  ],
  "goal": "final_video",
  "nodes": [
    {
      "id": "cast",
      "displayName": "Cast (from script)",
      "kind": "stage",
      "inputs": [
        {
          "from": "script_input",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/cast.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/cast.md",
          "outputSchema": "schemas/cast.schema.json",
          "tier": "heavy",
          "outputFormat": "json",
          "temperature": 0.1,
          "maxTokens": 16000
        }
      },
      "displayCapability": "cast.plan"
    },
    {
      "id": "world_style",
      "displayName": "World & Style",
      "kind": "stage",
      "inputs": [
        {
          "from": "script_input",
          "usage": "context"
        },
        {
          "from": "cast",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "plans/world_style.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/world_style.md",
          "tier": "heavy",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "style.world"
    },
    {
      "id": "character_image_prompt",
      "displayName": "Actor Prompts",
      "kind": "collection",
      "itemSource": "cast",
      "itemKey": "characters",
      "inputs": [
        {
          "from": "cast",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/character_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/character_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "displayCapability": "character.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "character_image",
      "displayName": "Actors",
      "kind": "collection",
      "itemSource": "character_image_prompt",
      "inputs": [
        {
          "from": "character_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/characters/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.tti",
        "config": {
          "workflowPath": "workflows/krea2_tti.json",
          "manifestPath": "workflows/krea2_tti.manifest.json",
          "endpoint": "self.local",
          "width": 832,
          "height": 1472
        }
      },
      "displayCapability": "character.image"
    },
    {
      "id": "setting_image_prompt",
      "displayName": "Setting Prompts",
      "kind": "collection",
      "itemSource": "cast",
      "itemKey": "characters",
      "inputs": [
        {
          "from": "cast",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/setting_images/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/setting_image.md",
          "tier": "medium",
          "outputFormat": "json"
        }
      },
      "displayCapability": "setting.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "setting_image",
      "displayName": "Settings",
      "kind": "collection",
      "itemSource": "setting_image_prompt",
      "inputs": [
        {
          "from": "setting_image_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/settings/{{item_id}}.png"
      },
      "runner": {
        "tool": "comfy.tti",
        "config": {
          "workflowPath": "workflows/krea2_tti.json",
          "manifestPath": "workflows/krea2_tti.manifest.json",
          "endpoint": "self.local",
          "width": 832,
          "height": 1472
        }
      },
      "displayCapability": "setting.image"
    },
    {
      "id": "frame_prompt",
      "displayName": "First-Frame Prompts (edit)",
      "kind": "collection",
      "itemSource": "cast",
      "itemKey": "characters",
      "inputs": [
        {
          "from": "cast",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/frames/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/frame_prompt.md",
          "outputSchema": "schemas/shot_image_prompt.schema.json",
          "tier": "heavy",
          "outputFormat": "json"
        }
      },
      "displayCapability": "frame.prompt",
      "headlineField": "imagePrompt"
    },
    {
      "id": "first_frame",
      "displayName": "First Frame (actor in scene)",
      "kind": "collection",
      "itemSource": "frame_prompt",
      "inputs": [
        {
          "from": "frame_prompt",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "image",
        "pattern": "assets/images/frames/{{item_id}}_first.png"
      },
      "runner": {
        "tool": "comfy.tti",
        "config": {
          "workflowPath": "workflows/krea2_tti.json",
          "manifestPath": "workflows/krea2_tti.manifest.json",
          "endpoint": "self.local",
          "width": 832,
          "height": 1472
        }
      },
      "displayCapability": "shot.first_frame"
    },
    {
      "id": "character_voice_prompt",
      "displayName": "Voice Tags",
      "kind": "collection",
      "itemSource": "cast",
      "itemKey": "characters",
      "inputs": [
        {
          "from": "cast",
          "usage": "input"
        },
        {
          "from": "world_style",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "prompts/voices/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/character_voice_prompt.md",
          "outputSchema": "schemas/voice_instruct.schema.json",
          "tier": "medium",
          "outputFormat": "json",
          "temperature": 0.3
        }
      },
      "displayCapability": "character.voice_prompt"
    },
    {
      "id": "character_voice",
      "displayName": "Voice Design",
      "kind": "collection",
      "itemSource": "character_voice_prompt",
      "inputs": [
        {
          "from": "character_voice_prompt",
          "usage": "input"
        }
      ],
      "outputs": {
        "format": "audio",
        "pattern": "assets/voices/{{item_id}}.wav"
      },
      "runner": {
        "tool": "comfy.tts",
        "config": {
          "workflowPath": "workflows/omnivoice_design.json",
          "endpoint": "self.local",
          "textInput": "character_voice_prompt",
          "textInputField": "voice_instruct",
          "textNodeId": "30",
          "textField": "voice_instruct",
          "fields": {
            "30": {
              "text": "अरे वाह, यह तो कमाल हो गया! सच में? मुझे तो यकीन ही नहीं हो रहा... कितना शानदार है यह सब!",
              "speed": 1.0,
              "seed": 42,
              "guidance_scale": 3
            }
          }
        }
      },
      "displayCapability": "character.voice"
    },
    {
      "id": "dialogue",
      "displayName": "Spoken Line (verbatim)",
      "kind": "collection",
      "itemSource": "cast",
      "itemKey": "characters",
      "inputs": [
        {
          "from": "cast",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "json",
        "pattern": "plans/dialogue/{{item_id}}.json"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/dialogue.md",
          "outputSchema": "schemas/shot_dialogue.schema.json",
          "tier": "medium",
          "outputFormat": "json",
          "temperature": 0
        }
      },
      "displayCapability": "shot.dialogue"
    },
    {
      "id": "shot_audio",
      "displayName": "Voice Acting (exact line)",
      "kind": "collection",
      "itemSource": "dialogue",
      "inputs": [
        {
          "from": "dialogue",
          "usage": "input"
        },
        {
          "from": "character_voice",
          "usage": "input"
        }
      ],
      "outputs": {
        "format": "audio",
        "pattern": "assets/audio/shots/{{item_id}}.wav"
      },
      "runner": {
        "tool": "comfy.tts",
        "config": {
          "workflowPath": "workflows/higgs_clone.json",
          "endpoint": "self.local",
          "textInput": "dialogue",
          "textInputField": "line",
          "textNodeId": "2",
          "textField": "text",
          "voiceSample": "assets/voices/{{speaker}}.wav",
          "voiceNodeId": "13",
          "voiceField": "audio",
          "fields": {
            "2": {
              "seed": 42,
              "longform_chunking": true,
              "max_new_tokens": 4096,
              "temperature": 1.0
            }
          }
        }
      },
      "displayCapability": "shot.audio"
    },
    {
      "id": "shot_motion_directive",
      "displayName": "Motion Directive",
      "kind": "collection",
      "itemSource": "dialogue",
      "inputs": [
        {
          "from": "dialogue",
          "usage": "input"
        },
        {
          "from": "frame_prompt",
          "usage": "context",
          "scope": "matching"
        },
        {
          "from": "cast",
          "usage": "context"
        }
      ],
      "outputs": {
        "format": "md",
        "pattern": "prompts/motion/{{item_id}}.md"
      },
      "runner": {
        "tool": "llm.generate",
        "config": {
          "promptTemplate": "prompts/shot_motion_directive.md",
          "tier": "medium",
          "outputFormat": "markdown"
        }
      },
      "displayCapability": "shot.motion"
    },
    {
      "id": "shot_video",
      "displayName": "Clips (lip-sync)",
      "kind": "collection",
      "itemSource": "first_frame",
      "inputs": [
        {
          "from": "first_frame",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_audio",
          "usage": "input",
          "scope": "matching"
        },
        {
          "from": "shot_motion_directive",
          "usage": "input",
          "scope": "matching"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/shots/{{item_id}}.mp4"
      },
      "runner": {
        "tool": "comfy.ltx_director",
        "config": {
          "workflowPath": "workflows/ltx_director_local.json",
          "endpoint": "self.local",
          "imageInput": "first_frame",
          "audioInput": "shot_audio",
          "promptInput": "shot_motion_directive",
          "lipSync": true,
          "width": 832,
          "height": 1472,
          "guideStrength": 0.5,
          "loras": [
            {
              "name": "LTX-2.3-22b-AV-LoRA-talking-head-v1.safetensors",
              "strength": 0.7
            }
          ],
          "fps": 24
        }
      },
      "displayCapability": "shot.video"
    },
    {
      "id": "final_video",
      "displayName": "Final Cut",
      "kind": "stage",
      "inputs": [
        {
          "from": "shot_video",
          "usage": "input",
          "scope": "all"
        }
      ],
      "outputs": {
        "format": "video",
        "pattern": "assets/videos/final/final_video.mp4"
      },
      "runner": {
        "tool": "ffmpeg.concat",
        "config": {}
      },
      "displayCapability": "final.video"
    }
  ],
  "display": {
    "thumbnail": {
      "from": [
        "shot.first_frame",
        "character.image"
      ],
      "pick": "first_completed"
    },
    "stats": [
      {
        "label": "actors",
        "source": "cast.plan",
        "path": "characters.length"
      }
    ]
  }
}