{
  "type": "object",
  "required": [
    "imagePrompt",
    "aspectRatio",
    "generationMode"
  ],
  "properties": {
    "imagePrompt": {
      "type": "string",
      "minLength": 30
    },
    "aspectRatio": {
      "type": "string"
    },
    "generationMode": {
      "type": "string",
      "enum": [
        "text_to_image",
        "image_edit"
      ]
    },
    "references": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "character",
              "setting",
              "plate"
            ]
          }
        }
      }
    },
    "plate": {
      "type": "string",
      "description": "the chosen setting plate id, <settingId>_<angle>; must equal references[0].id"
    }
  }
}