{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["totalDurationSec", "aspect", "style", "shots"],
  "properties": {
    "totalDurationSec": { "type": "number", "const": 30 },
    "aspect": { "type": "string", "const": "9:16" },
    "style": { "type": "string" },
    "shots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "shotNumber", "startSec", "duration", "description", "speaker", "dialogue"],
        "properties": {
          "id": { "type": "string" },
          "shotNumber": { "type": "number", "minimum": 1, "maximum": 5 },
          "startSec": { "type": "number" },
          "duration": { "type": "number", "const": 6 },
          "description": { "type": "string" },
          "speaker": { "type": "string" },
          "dialogue": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
