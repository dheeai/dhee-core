{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["totalDurationSec", "shots"],
  "properties": {
    "totalDurationSec": { "type": "number", "const": 30 },
    "shots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["shotNumber", "durationSec", "imagePrompt", "motionDirective", "dialogueLine"],
        "properties": {
          "shotNumber": { "type": "number", "minimum": 1, "maximum": 5 },
          "durationSec": { "type": "number", "const": 6 },
          "imagePrompt": { "type": "string" },
          "motionDirective": { "type": "string" },
          "dialogueLine": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
