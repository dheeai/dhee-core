{
  "ckpt": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sam3.1_multiplex_fp16.safetensors" } },
  "img": { "class_type": "LoadImage", "inputs": { "image": "__UPLOADED__" } },
  "txt": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["ckpt", 1], "text": "__CONCEPT__" } },
  "sam": { "class_type": "SAM3_Detect", "inputs": { "model": ["ckpt", 0], "image": ["img", 0], "conditioning": ["txt", 0], "threshold": 0.5, "refine_iterations": 2, "individual_masks": false } },
  "size": { "class_type": "GetImageSize", "inputs": { "image": ["img", 0] } },
  "white": { "class_type": "EmptyImage", "inputs": { "width": ["size", 0], "height": ["size", 1], "batch_size": 1, "color": 16777215 } },
  "comp": { "class_type": "ImageCompositeMasked", "inputs": { "destination": ["white", 0], "source": ["img", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["sam", 0] } },
  "savewhite": { "class_type": "SaveImage", "inputs": { "images": ["comp", 0], "filename_prefix": "matte/onwhite" } },
  "m2i": { "class_type": "MaskToImage", "inputs": { "mask": ["sam", 0] } },
  "savemask": { "class_type": "SaveImage", "inputs": { "images": ["m2i", 0], "filename_prefix": "matte/mask" } }
}
