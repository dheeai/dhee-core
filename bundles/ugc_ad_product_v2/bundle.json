{
  "id": "ugc_ad_product_v2",
  "version": "0.1.0",
  "license": "MIT",
  "displayName": "UGC Product Ad v2 (matte → blend → motion)",
  "summary": "Themed product ad where the real product is SAM3-extracted, then model-composited (boogu) into themed scenes at mid/far distance so its label is sub-readable (the diffusion's text-fudge is invisible by design), then animated (LTX) into an alive video. Voiceover language configurable.",
  "techLine": "SAM3 matte · Boogu model-composite (far/blended) · LTX-2 image-to-video · OmniVoice cloned VO (any language) · ffmpeg concat",
  "engineCompat": ">=0.1.0",
  "description": "Product-hero ad pipeline that keeps the product believably blended into the scene WITHOUT a brand-wrong label. The product is extracted with comfy.matte (SAM 3, concept-prompted) to a clean reference, then comfy.boogu composites it into themed scenes — deliberately mid/far so the fine label text is not legible and the diffusion's re-lettering is invisible. Each beat is animated by comfy.ltx_director (alive atmosphere, sized to its voiceover). A theme input drives the creative brief, which cascades into scripts (in the chosen language) and scene placement. Three beats: establishing → hero → close. Brand recognition is carried by the voiceover (and an optional logo overlay), not by reading the tiny product label. Set `language` to dub (English / Kannada / Telugu / Hindi / ...).",
  "dependencies": {
    "runners": {
      "llm.generate": ">=0.1.0",
      "comfy.matte": ">=0.1.0",
      "comfy.boogu": ">=0.1.0",
      "comfy.tts": ">=0.1.0",
      "comfy.ltx_director": ">=0.1.0",
      "ffmpeg.concat": ">=0.1.0"
    },
    "runnerPackages": {
      "comfy.matte": "@dhee_ai/runner-matte",
      "comfy.boogu": "@dhee_ai/runner-boogu",
      "comfy.tts": "@dhee_ai/runner-tts"
    }
  },
  "inputs": [
    { "id": "product_description", "kind": "file", "path": "inputs/product.md", "required": false, "label": "Product description", "multiline": true },
    { "id": "product_image", "kind": "file", "path": "inputs/product.png", "required": false, "label": "Product photo (the real product / pack shot)" },
    { "id": "brand_logo", "kind": "file", "path": "inputs/logo.png", "required": false, "label": "Brand logo (transparent PNG) — overlaid as the end-card on the closing beat" },
    { "id": "product_concept", "kind": "project", "field": "product_concept", "default": "product package, jar, tub, bottle, can, or box", "label": "Product concept (for segmentation)", "placeholder": "What to segment out of the image, e.g. 'jar of cookies', 'shampoo bottle', 'cereal box'." },
    { "id": "theme", "kind": "project", "field": "theme", "default": "", "label": "Theme / occasion", "placeholder": "e.g. Rainy season, Women's Day, Diwali. Blank = evergreen." },
    { "id": "language", "kind": "project", "field": "language", "default": "English", "label": "Voiceover language", "placeholder": "English / Kannada / Telugu / Hindi / ... — the spoken language of the ad." },
    { "id": "voice_style", "kind": "project", "field": "voice_style", "default": "warm, natural, conversational", "label": "Voiceover energy / delivery style", "placeholder": "e.g. 'calm and warm' or 'super excited, high-energy voice acting'. Drives the script's energy and phrasing." },
    { "id": "aspect", "kind": "project", "field": "aspect", "default": "9:16", "label": "Aspect", "control": "pills", "options": [ { "value": "9:16", "label": "9:16" }, { "value": "1:1", "label": "1:1" }, { "value": "16:9", "label": "16:9" } ] }
  ],
  "goal": "final_video",
  "nodes": [
    {
      "id": "creative_brief", "displayName": "Creative Brief", "kind": "stage", "inputs": [],
      "outputs": { "format": "md", "pattern": "plans/creative_brief.md" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/creative_brief.md", "tier": "heavy", "outputFormat": "markdown", "temperature": 0.6 } },
      "displayCapability": "brief"
    },
    {
      "id": "product_matte", "displayName": "Product Matte (SAM 3)", "kind": "stage",
      "inputs": [],
      "outputs": { "format": "image", "pattern": "assets/images/product_matte.png" },
      "runner": { "tool": "comfy.matte", "config": { "endpoint": "self.local", "imageInput": "product_image", "conceptInput": "product_concept", "threshold": 0.5 } },
      "displayCapability": "product.matte"
    },

    { "id": "hook_script", "displayName": "Hook Voiceover", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" } ],
      "outputs": { "format": "md", "pattern": "plans/hook_script.md" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/hook_script.md", "tier": "heavy", "outputFormat": "markdown", "temperature": 0.6 } },
      "displayCapability": "script.hook" },
    { "id": "benefit_script", "displayName": "Benefit Voiceover", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" }, { "from": "hook_script", "usage": "context" } ],
      "outputs": { "format": "md", "pattern": "plans/benefit_script.md" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/benefit_script.md", "tier": "heavy", "outputFormat": "markdown", "temperature": 0.6 } },
      "displayCapability": "script.benefit" },
    { "id": "close_script", "displayName": "Closing Voiceover", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" }, { "from": "hook_script", "usage": "context" }, { "from": "benefit_script", "usage": "context" } ],
      "outputs": { "format": "md", "pattern": "plans/close_script.md" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/close_script.md", "tier": "heavy", "outputFormat": "markdown", "temperature": 0.6 } },
      "displayCapability": "script.close" },

    { "id": "beat_open_prompt", "displayName": "Opening Placement", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" } ],
      "outputs": { "format": "json", "pattern": "prompts/beat_open.json" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/beat_open_prompt.md", "outputSchema": "schemas/placement.schema.json", "tier": "medium", "outputFormat": "json", "temperature": 0.5 } },
      "displayCapability": "beat.open_prompt" },
    { "id": "beat_open_frame", "displayName": "Opening Scene", "kind": "stage",
      "inputs": [ { "from": "beat_open_prompt", "usage": "input" }, { "from": "product_matte", "usage": "reference" } ],
      "outputs": { "format": "image", "pattern": "assets/images/beat_open.png" },
      "runner": { "tool": "comfy.boogu", "config": { "workflowPath": "workflows/boogu.json", "endpoint": "self.local", "width": 768, "height": 1344 } },
      "displayCapability": "beat.open_frame" },

    { "id": "beat_hero_prompt", "displayName": "Hero Placement", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" } ],
      "outputs": { "format": "json", "pattern": "prompts/beat_hero.json" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/beat_hero_prompt.md", "outputSchema": "schemas/placement.schema.json", "tier": "medium", "outputFormat": "json", "temperature": 0.5 } },
      "displayCapability": "beat.hero_prompt" },
    { "id": "beat_hero_frame", "displayName": "Hero Scene", "kind": "stage",
      "inputs": [ { "from": "beat_hero_prompt", "usage": "input" }, { "from": "product_matte", "usage": "reference" } ],
      "outputs": { "format": "image", "pattern": "assets/images/beat_hero.png" },
      "runner": { "tool": "comfy.boogu", "config": { "workflowPath": "workflows/boogu.json", "endpoint": "self.local", "width": 768, "height": 1344 } },
      "displayCapability": "beat.hero_frame" },

    { "id": "beat_close_prompt", "displayName": "Closing Placement", "kind": "stage",
      "inputs": [ { "from": "creative_brief", "usage": "context" } ],
      "outputs": { "format": "json", "pattern": "prompts/beat_close.json" },
      "runner": { "tool": "llm.generate", "config": { "promptTemplate": "prompts/beat_close_prompt.md", "outputSchema": "schemas/placement.schema.json", "tier": "medium", "outputFormat": "json", "temperature": 0.5 } },
      "displayCapability": "beat.close_prompt" },
    { "id": "beat_close_frame", "displayName": "Closing Scene", "kind": "stage",
      "inputs": [ { "from": "beat_close_prompt", "usage": "input" }, { "from": "product_matte", "usage": "reference" } ],
      "outputs": { "format": "image", "pattern": "assets/images/beat_close.png" },
      "runner": { "tool": "comfy.boogu", "config": { "workflowPath": "workflows/boogu.json", "endpoint": "self.local", "width": 768, "height": 1344 } },
      "displayCapability": "beat.close_frame" },

    { "id": "designed_voice", "displayName": "Designed Voice", "kind": "stage",
      "inputs": [ { "from": "hook_script", "usage": "input" } ],
      "outputs": { "format": "audio", "pattern": "assets/voices/designed.wav" },
      "runner": { "tool": "comfy.tts", "config": { "workflowPath": "workflows/omnivoice_design.json", "endpoint": "self.local", "textInput": "hook_script", "textNodeId": "30", "textField": "text", "fields": { "30": { "voice_instruct": "female, moderate pitch, indian accent", "speed": 1.0, "seed": 42, "guidance_scale": 3 } } } },
      "displayCapability": "voice.design" },
    { "id": "hook_audio", "displayName": "Hook Audio", "kind": "stage",
      "inputs": [ { "from": "hook_script", "usage": "input" }, { "from": "designed_voice", "usage": "reference" } ],
      "outputs": { "format": "audio", "pattern": "assets/audio/hook.wav" },
      "runner": { "tool": "comfy.tts", "config": { "workflowPath": "workflows/omnivoice_clone.json", "endpoint": "self.local", "textInput": "hook_script", "textNodeId": "28", "textField": "text", "voiceSample": "assets/voices/designed.wav", "voiceNodeId": "13", "voiceField": "audio", "fields": { "28": { "speed": 0.95, "seed": 42, "temperature": 1.2, "guidance_scale": 3 } } } },
      "displayCapability": "hook.audio" },
    { "id": "benefit_audio", "displayName": "Benefit Audio", "kind": "stage",
      "inputs": [ { "from": "benefit_script", "usage": "input" }, { "from": "designed_voice", "usage": "reference" } ],
      "outputs": { "format": "audio", "pattern": "assets/audio/benefit.wav" },
      "runner": { "tool": "comfy.tts", "config": { "workflowPath": "workflows/omnivoice_clone.json", "endpoint": "self.local", "textInput": "benefit_script", "textNodeId": "28", "textField": "text", "voiceSample": "assets/voices/designed.wav", "voiceNodeId": "13", "voiceField": "audio", "fields": { "28": { "speed": 0.95, "seed": 42, "temperature": 1.2, "guidance_scale": 3 } } } },
      "displayCapability": "benefit.audio" },
    { "id": "close_audio", "displayName": "Closing Audio", "kind": "stage",
      "inputs": [ { "from": "close_script", "usage": "input" }, { "from": "designed_voice", "usage": "reference" } ],
      "outputs": { "format": "audio", "pattern": "assets/audio/close.wav" },
      "runner": { "tool": "comfy.tts", "config": { "workflowPath": "workflows/omnivoice_clone.json", "endpoint": "self.local", "textInput": "close_script", "textNodeId": "28", "textField": "text", "voiceSample": "assets/voices/designed.wav", "voiceNodeId": "13", "voiceField": "audio", "fields": { "28": { "speed": 0.95, "seed": 7, "temperature": 1.2, "guidance_scale": 3 } } } },
      "displayCapability": "close.audio" },

    { "id": "open_clip", "displayName": "Opening Beat", "kind": "stage",
      "inputs": [ { "from": "beat_open_frame", "usage": "input" }, { "from": "hook_audio", "usage": "input" } ],
      "outputs": { "format": "video", "pattern": "assets/videos/open.mp4" },
      "runner": { "tool": "comfy.ltx_director", "config": { "workflowPath": "workflows/ltx_director_local.json", "endpoint": "self.local", "imageInput": "beat_open_frame", "audioInput": "hook_audio", "lipSync": false, "guideStrength": 0.6, "globalPrompt": "Atmosphere alive — drifting rain and mist, soft shifting light, gentle slow push-in, the product stays still and unchanged, cinematic, photorealistic.", "fps": 24, "width": 768, "height": 1344 } },
      "displayCapability": "open.clip" },
    { "id": "hero_clip", "displayName": "Hero Beat", "kind": "stage",
      "inputs": [ { "from": "beat_hero_frame", "usage": "input" }, { "from": "benefit_audio", "usage": "input" } ],
      "outputs": { "format": "video", "pattern": "assets/videos/hero.mp4" },
      "runner": { "tool": "comfy.ltx_director", "config": { "workflowPath": "workflows/ltx_director_local.json", "endpoint": "self.local", "imageInput": "beat_hero_frame", "audioInput": "benefit_audio", "lipSync": false, "guideStrength": 0.6, "globalPrompt": "Atmosphere alive — rain, steam rising, warm light shifting, gentle slow zoom toward the product, the product stays still and unchanged, cinematic, photorealistic.", "fps": 24, "width": 768, "height": 1344 } },
      "displayCapability": "hero.clip" },
    { "id": "close_clip", "displayName": "Closing Beat", "kind": "stage",
      "inputs": [ { "from": "beat_close_frame", "usage": "input" }, { "from": "close_audio", "usage": "input" } ],
      "outputs": { "format": "video", "pattern": "assets/videos/close.mp4" },
      "runner": { "tool": "comfy.ltx_director", "config": { "workflowPath": "workflows/ltx_director_local.json", "endpoint": "self.local", "imageInput": "beat_close_frame", "audioInput": "close_audio", "lipSync": false, "guideStrength": 0.6, "globalPrompt": "Calm closing motion — warm light glowing, faint steam and rain, the product stays still and unchanged, slow settle, cinematic, photorealistic.", "fps": 24, "width": 768, "height": 1344 } },
      "displayCapability": "close.clip" },

    { "id": "close_branded", "displayName": "Closing Beat + Logo", "kind": "stage",
      "inputs": [ { "from": "close_clip", "usage": "input" } ],
      "outputs": { "format": "video", "pattern": "assets/videos/close_branded.mp4" },
      "runner": { "tool": "ffmpeg.overlay", "config": { "baseInput": "close_clip", "overlayInput": "brand_logo", "position": "bottom", "scale": 0.32, "margin": 90, "borderWidth": 0 } },
      "displayCapability": "close.branded" },

    { "id": "final_video", "displayName": "Final Ad", "kind": "stage",
      "inputs": [ { "from": "open_clip", "usage": "input" }, { "from": "hero_clip", "usage": "input" }, { "from": "close_branded", "usage": "input" } ],
      "outputs": { "format": "video", "pattern": "assets/videos/final/final_video.mp4" },
      "runner": { "tool": "ffmpeg.concat", "config": { "transition": "fade", "transitionDuration": 0.4 } },
      "displayCapability": "final.video" }
  ]
}
