{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Ideogram 4 structured caption for one infographic segment. comfy.tti passes this object to the workflow's prompt node as minified JSON.",
  "type": "object",
  "required": ["high_level_description", "style_description", "compositional_deconstruction"],
  "additionalProperties": false,
  "properties": {
    "high_level_description": { "type": "string", "minLength": 1 },
    "style_description": {
      "type": "object",
      "required": ["aesthetics", "medium", "art_style", "color_palette"],
      "additionalProperties": true,
      "properties": {
        "aesthetics": { "type": "string" },
        "lighting": { "type": "string" },
        "medium": { "type": "string" },
        "art_style": { "type": "string" },
        "color_palette": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" } }
      }
    },
    "compositional_deconstruction": {
      "type": "object",
      "required": ["background", "elements"],
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string" },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "desc"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["text", "obj"] },
              "text": { "type": "string" },
              "desc": { "type": "string" },
              "bbox": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1000 }, "minItems": 4, "maxItems": 4 },
              "colors": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" } }
            }
          }
        }
      }
    }
  }
}
