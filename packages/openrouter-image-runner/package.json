{
  "name": "dhee-runner-openrouter-image",
  "version": "0.1.0",
  "description": "OpenRouter image-generation runner for Dhee (the reference dhee-runner-* package).",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["dhee-runner"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dhee": {
    "runners": "./dist/index.js"
  },
  "files": ["dist", "runner.json", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20.0.0" },
  "dependencies": { "@dhee/runner-sdk": "workspace:*" },
  "devDependencies": { "@types/node": "^22.15.29", "typescript": "^5.8.3" }
}
