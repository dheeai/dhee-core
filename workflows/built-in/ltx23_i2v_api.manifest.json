{
  "id": "ltx23_i2v_api",
  "displayName": "LTX 2.3 I2V (API format)",
  "pipeline": "video_generation",
  "llmDescription": "Image-to-video generation using LTX 2.3 with only a first-frame anchor. The model improvises subtle ambient motion. Use for holding beats where subject and camera are static.",
  "selectionCriteria": "Use for holding beats (static subject + static camera). Skips last-frame generation entirely.",
  "outputType": "video",
  "priority": 10,
  "strategies": [
    "i2v"
  ],
  "inputRequirements": [
    {
      "id": "prompt",
      "type": "text",
      "source": "shot_motion_directive",
      "description": "Motion prompt",
      "required": true
    },
    {
      "id": "negative_prompt",
      "type": "text",
      "source": "system",
      "description": "Negative prompt",
      "required": true
    },
    {
      "id": "first_frame",
      "type": "image",
      "source": "shot_image",
      "description": "First frame image (the only anchor for i2v)",
      "required": true
    },
    {
      "id": "seed",
      "type": "number",
      "source": "system",
      "description": "Random seed",
      "required": false
    },
    {
      "id": "filenamePrefix",
      "type": "text",
      "source": "system",
      "description": "Output filename prefix",
      "required": false
    },
    {
      "id": "lora_strength",
      "type": "number",
      "source": "system",
      "description": "Strength of the LTX I2V LoRA (LiconStudio Ltx2.3-VBVR-iora-I2V).",
      "required": false
    }
  ],
  "workflowFile": "ltx23_i2v_api.json",
  "format": "api",
  "parameterMappings": [
    {
      "input": "prompt",
      "nodeId": "16",
      "field": "text"
    },
    {
      "input": "negative_prompt",
      "nodeId": "11",
      "field": "text"
    },
    {
      "input": "first_frame",
      "nodeId": "45",
      "field": "image"
    },
    {
      "input": "seed",
      "nodeId": "15",
      "field": "noise_seed"
    },
    {
      "input": "seed",
      "nodeId": "14",
      "field": "noise_seed"
    },
    {
      "input": "filenamePrefix",
      "nodeId": "43",
      "field": "filename_prefix"
    },
    {
      "input": "lora_strength",
      "nodeId": "217",
      "field": "strength_model"
    }
  ],
  "promptKeywords": {
    "negativeAppend": "static, blurry, low quality, distorted"
  },
  "builtIn": true,
  "active": true,
  "mode": "local",
  "defaultValues": {
    "lora_strength": 1.0
  }
}
