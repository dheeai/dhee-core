{
  "id": "ltx23_i2v_cloud",
  "displayName": "LTX 2.3 I2V (Cloud)",
  "pipeline": "video_generation",
  "llmDescription": "Cloud image-to-video generation using LTX 2.3 with only a first-frame anchor. Derived from the FL2V cloud workflow by wiring the second LTX anchor slot back to the first frame. Model improvises subtle ambient motion.",
  "selectionCriteria": "Use for holding beats (static subject + static camera) on ComfyUI Cloud. Skips last-frame generation entirely.",
  "outputType": "video",
  "priority": 10,
  "strategies": [
    "i2v"
  ],
  "inputRequirements": [
    {
      "id": "prompt",
      "type": "text",
      "source": "llm",
      "required": true
    },
    {
      "id": "negative_prompt",
      "type": "text",
      "source": "llm",
      "required": false
    },
    {
      "id": "first_frame",
      "type": "image",
      "source": "shot_image",
      "description": "First frame image (the only anchor for i2v)",
      "required": true
    },
    {
      "id": "seed",
      "type": "number",
      "source": "system",
      "required": false
    },
    {
      "id": "durationSeconds",
      "type": "number",
      "source": "system",
      "description": "Video duration in seconds",
      "required": false
    },
    {
      "id": "filenamePrefix",
      "type": "text",
      "source": "system",
      "required": false
    },
    {
      "id": "lora_strength",
      "type": "number",
      "source": "system",
      "description": "Strength of the LTX I2V LoRA (LiconStudio Ltx2.3-VBVR-iora-I2V).",
      "required": false
    }
  ],
  "workflowFile": "ltx23_i2v_cloud.json",
  "format": "api",
